{
  "name": "NV-MutI-GPU-Monitor",
  "displayName": "Multi-GPU Monitor",
  "description": "Compact real-time NVIDIA GPU monitor for multi-GPU machines, in the VS Code sidebar or panel. Fork of GPU Monitoring Service by Minato3000.",
  "version": "0.2.0",
  "publisher": "Heisenberg1159",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Heisenberg1159/gpu-monitoring-service"
  },
  "keywords": [
    "nvidia",
    "gpu",
    "multi-gpu",
    "nvidia-smi",
    "cuda",
    "monitor",
    "remote-ssh"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multi-gpu-monitor",
          "title": "Multi-GPU Monitor",
          "icon": "icons/gpu-monitor.svg"
        }
      ]
    },
    "views": {
      "multi-gpu-monitor": [
        {
          "type": "webview",
          "id": "multiGpuMonitor.panel",
          "name": "GPUs",
          "icon": "icons/gpu-monitor.svg",
          "contextualTitle": "Multi-GPU Monitor"
        }
      ]
    },
    "commands": [
      {
        "command": "multiGpuMonitor.refresh",
        "title": "Multi-GPU Monitor: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "multiGpuMonitor.refresh",
          "when": "view == multiGpuMonitor.panel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Multi-GPU Monitor",
      "properties": {
        "multiGpuMonitor.refreshInterval": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 30000,
          "description": "Polling interval in milliseconds (default: 2000ms)"
        },
        "multiGpuMonitor.nvidiaSmiPath": {
          "type": "string",
          "default": "nvidia-smi",
          "description": "Path to the nvidia-smi executable"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.15.0"
  }
}
